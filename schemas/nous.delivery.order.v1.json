{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nous.example/schemas/nous.delivery.order.v1.json",
  "title": "NØUS canonical delivery order v1 — synthetic laboratory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "order_id",
    "source",
    "external_order_id",
    "merchant_id",
    "status",
    "source_status",
    "occurred_at",
    "currency",
    "items",
    "totals",
    "payment",
    "fulfillment",
    "mapping_version"
  ],
  "properties": {
    "schema_version": {
      "const": "nous.delivery.order.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "ifood",
        "99food"
      ]
    },
    "external_order_id": {
      "type": "string",
      "minLength": 1
    },
    "merchant_id": {
      "type": "string",
      "minLength": 1
    },
    "customer": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "external_id"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "CREATED",
        "CONFIRMED",
        "PREPARING",
        "READY",
        "DISPATCHED",
        "COMPLETED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "source_status": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "const": "BRL"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_item_id",
          "name",
          "quantity",
          "unit_price_minor",
          "line_total_minor"
        ],
        "properties": {
          "external_item_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price_minor": {
            "type": "integer",
            "minimum": 0
          },
          "line_total_minor": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtotal_minor",
        "delivery_fee_minor",
        "discount_minor",
        "total_minor"
      ],
      "properties": {
        "subtotal_minor": {
          "type": "integer",
          "minimum": 0
        },
        "delivery_fee_minor": {
          "type": "integer",
          "minimum": 0
        },
        "discount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "total_minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "status"
      ],
      "properties": {
        "method": {
          "enum": [
            "CASH",
            "CARD",
            "PIX",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "AUTHORIZED",
            "PAID",
            "REFUNDED",
            "FAILED",
            "UNKNOWN"
          ]
        }
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status"
      ],
      "properties": {
        "type": {
          "enum": [
            "DELIVERY",
            "PICKUP",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "PENDING",
            "PREPARING",
            "READY",
            "IN_TRANSIT",
            "DELIVERED",
            "CANCELLED",
            "UNKNOWN"
          ]
        }
      }
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
