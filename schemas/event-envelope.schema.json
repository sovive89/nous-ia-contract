{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NØUS Business Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source",
    "tenant_id",
    "event_type",
    "schema_ref",
    "occurred_at",
    "subject",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "entity_type",
        "external_id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object"
    }
  }
}
